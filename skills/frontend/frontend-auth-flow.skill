# Constraints

- Never store tokens in localStorage or sessionStorage.
- Access tokens must expire within 15 minutes.
- Refresh tokens must use a separate cookie path (e.g., /api/auth/refresh).
- All cookies must be httpOnly, Secure, and SameSite.
- Token refresh must be transparent — the user must never see a "session expired" page if a refresh token is valid.
- OAuth flows must use PKCE (Proof Key for Code Exchange).
- CSRF protection is required for all state-changing requests.
- Multi-tab sync must handle both login and logout events.
- Logout must clear all cookies, query caches, and persisted state.
- Middleware must not make database calls — use JWT verification only.

# Examples

## Example: Complete Login Page

```tsx
'use client';

import { useAuth } from '@/hooks/useAuth';
import { useRouter, useSearchParams } from 'next/navigation';
import { useState } from 'react';
import { initiateOAuthLogin } from '@/lib/oauth';

export default function LoginPage() {
  const { login } = useAuth();
  const router = useRouter();
  const searchParams = useSearchParams();
  const redirect = searchParams.get('redirect') ?? '/dashboard';

  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError(null);
    setLoading(true);

    try {
      await login(email, password);
      router.push(redirect);
    } catch (err) {
      setError('Invalid email or password');
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="min-h-screen flex items-center justify-center">
      <form onSubmit={handleSubmit} className="w-full max-w-md space-y-4 p-8">
        <h1 className="text-2xl font-bold text-center">Sign In</h1>

        {error && <p className="text-red-600 text-sm text-center">{error}</p>}

        <input type="email" value={email} onChange={(e) => setEmail(e.target.value)}
          placeholder="Email" required className="w-full p-3 border rounded-lg" />
        <input type="password" value={password} onChange={(e) => setPassword(e.target.value)}
          placeholder="Password" required className="w-full p-3 border rounded-lg" />

        <button type="submit" disabled={loading}
          className="w-full p-3 bg-blue-600 text-white rounded-lg disabled:opacity-50">
          {loading ? 'Signing in…' : 'Sign In'}
        </button>

        <div className="flex gap-3 mt-4">
          <button type="button" onClick={() => initiateOAuthLogin('google')}
            className="flex-1 p-3 border rounded-lg">Google</button>
          <button type="button" onClick={() => initiateOAuthLogin('github')}
            className="flex-1 p-3 border rounded-lg">GitHub</button>
        </div>
      </form>
    </div>
  );
}
```
