```

# Constraints

- Always clean up GSAP instances on component unmount — use useGSAP or gsap.context().
- Never animate layout-triggering CSS properties (width, height, top, left, padding, margin).
- ScrollTrigger instances must call kill() on cleanup.
- SplitText must call revert() before component unmount.
- Use gsap.matchMedia() for responsive animations — never manual resize listeners.
- Performance budget: no more than 50 simultaneous tweens; batch with stagger instead.
- Always provide a prefers-reduced-motion fallback.
- In Next.js App Router, GSAP components must be client components ('use client').
- Never import GSAP plugins in server components.

# Examples

## Example: Scroll-driven Section Reveal with Pinning

```tsx
'use client';

import { useRef } from 'react';
import { useGSAP } from '@gsap/react';
import { gsap, ScrollTrigger } from '@/lib/gsap-config';

interface Step {
  title: string;
  description: string;
  image: string;
}

export function SteppedReveal({ steps }: { steps: Step[] }) {
  const containerRef = useRef<HTMLDivElement>(null);

  useGSAP(() => {
    const panels = gsap.utils.toArray<HTMLElement>('.step-panel');

    panels.forEach((panel, i) => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: panel,
          start: 'top top',
          end: '+=100%',
          pin: true,
          scrub: 0.5,
          snap: 1,
        },
      });

      if (i < panels.length - 1) {
        tl.to(panel, { scale: 0.9, opacity: 0.3, duration: 1 });
      }

      tl.from(panel.querySelector('.step-image'), {
        clipPath: 'inset(100% 0 0 0)',
        duration: 1,
        ease: 'power3.inOut',
      }, 0);

      tl.from(panel.querySelector('.step-text'), {
        y: 60,
        opacity: 0,
        duration: 0.8,
      }, 0.3);
    });

    return () => { ScrollTrigger.getAll().forEach((t) => t.kill()); };
  }, { scope: containerRef });

  return (
    <div ref={containerRef}>
      {steps.map((step, i) => (
        <section key={i} className="step-panel h-screen flex items-center relative">
          <div className="grid grid-cols-2 gap-12 max-w-6xl mx-auto px-8">
            <div className="step-text">
              <span className="text-sm text-blue-600 font-mono">Step {i + 1}</span>
              <h2 className="text-4xl font-bold mt-2">{step.title}</h2>
              <p className="text-lg text-gray-600 mt-4">{step.description}</p>
            </div>
            <div className="step-image overflow-hidden rounded-2xl">
              <img src={step.image} alt={step.title} className="w-full h-full object-cover" />
            </div>
          </div>
        </section>
      ))}
    </div>
  );
}
```
