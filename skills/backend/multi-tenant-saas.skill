### Tenant Resolution Middleware (Django)

```python
import threading
from django.http import Http404
from django.core.cache import cache
from myapp.models import Tenant

_thread_local = threading.local()


def get_current_tenant():
    return getattr(_thread_local, "tenant", None)


class TenantMiddleware:
    TENANT_CACHE_TTL = 300  # 5 minutes

    def __init__(self, get_response):
        self.get_response = get_response

    def __call__(self, request):
        tenant = self._resolve_tenant(request)
        if tenant is None:
            raise Http404()

        _thread_local.tenant = tenant
        request.tenant = tenant

        try:
            response = self.get_response(request)
            response["X-Tenant-ID"] = str(tenant.id)
            return response
        finally:
            _thread_local.tenant = None

    def _resolve_tenant(self, request):
        host = request.get_host().split(":")[0]

        # Check custom domain mapping first
        tenant = self._lookup_by_custom_domain(host)
        if tenant:
            return tenant

        # Fall back to subdomain resolution
        subdomain = self._extract_subdomain(host)
        if not subdomain:
            return None

        return self._lookup_by_subdomain(subdomain)

    def _extract_subdomain(self, host):
        parts = host.split(".")
        if len(parts) >= 3:
            return parts[0]
        return None

    def _lookup_by_subdomain(self, subdomain):
        cache_key = f"tenant:subdomain:{subdomain}"
        tenant = cache.get(cache_key)
        if tenant is not None:
            return tenant if tenant != "__none__" else None

        try:
            tenant = Tenant.objects.get(subdomain=subdomain, is_active=True)
            cache.set(cache_key, tenant, self.TENANT_CACHE_TTL)
            return tenant
        except Tenant.DoesNotExist:
            cache.set(cache_key, "__none__", 60)  # Negative cache, shorter TTL
            return None

    def _lookup_by_custom_domain(self, domain):
        cache_key = f"tenant:domain:{domain}"
        tenant = cache.get(cache_key)
        if tenant is not None:
            return tenant if tenant != "__none__" else None

        try:
            tenant = Tenant.objects.get(custom_domain=domain, is_active=True)
            cache.set(cache_key, tenant, self.TENANT_CACHE_TTL)
            return tenant
        except Tenant.DoesNotExist:
            cache.set(cache_key, "__none__", 60)
            return None
```

### Schema Routing (Django Database Router)

```python
from django.db import connections
from myapp.middleware import get_current_tenant


class TenantSchemaRouter:
    def _set_search_path(self, tenant):
        schema = f"tenant_{tenant.schema_name}"
        connection = connections["default"]
        with connection.cursor() as cursor:
            cursor.execute("SET search_path TO %s, public", [schema])

    def db_for_read(self, model, **hints):
        tenant = get_current_tenant()
        if tenant and self._is_tenant_model(model):
            self._set_search_path(tenant)
        return "default"

    def db_for_write(self, model, **hints):
        tenant = get_current_tenant()
        if tenant and self._is_tenant_model(model):
            self._set_search_path(tenant)
        return "default"

    def _is_tenant_model(self, model):
        return getattr(model, "_is_tenant_scoped", False)
```

### Tenant-Scoped Base Model

```python
from django.db import models


class TenantScopedManager(models.Manager):
    def get_queryset(self):
        from myapp.middleware import get_current_tenant
        qs = super().get_queryset()
        tenant = get_current_tenant()
        if tenant is None:
            raise RuntimeError(
                "Attempted tenant-scoped query without tenant context. "
                "Ensure TenantMiddleware is active."
            )
        return qs


class TenantScopedModel(models.Model):
    _is_tenant_scoped = True
    objects = TenantScopedManager()

    class Meta:
        abstract = True
```

### Branding Configuration Model

```python
from django.db import models
from django.core.cache import cache


class TenantBranding(models.Model):
    tenant = models.OneToOneField("Tenant", on_delete=models.CASCADE, related_name="branding")
    logo_url = models.URLField(blank=True)
    primary_color = models.CharField(max_length=7, default="#1a73e8")
    secondary_color = models.CharField(max_length=7, default="#ffffff")
    favicon_url = models.URLField(blank=True)
    custom_css = models.TextField(blank=True)
    login_background_url = models.URLField(blank=True)
    updated_at = models.DateTimeField(auto_now=True)

    def save(self, *args, **kwargs):
        super().save(*args, **kwargs)
        cache.delete(f"branding:{self.tenant_id}")

    def to_config_dict(self):
        return {
            "logo_url": self.logo_url,
            "primary_color": self.primary_color,
            "secondary_color": self.secondary_color,
            "favicon_url": self.favicon_url,
            "custom_css": self.custom_css,
            "login_background_url": self.login_background_url,
        }
```

### Go Microservice Tenant Interceptor

```go
package middleware

import (
	"context"
	"fmt"

	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/metadata"
	"google.golang.org/grpc/status"
)

type tenantKey struct{}

func TenantFromContext(ctx context.Context) (string, error) {
	tid, ok := ctx.Value(tenantKey{}).(string)
	if !ok || tid == "" {
		return "", fmt.Errorf("no tenant in context")
	}
	return tid, nil
}

func UnaryTenantInterceptor(allowedTenants map[string]bool) grpc.UnaryServerInterceptor {
	return func(
		ctx context.Context,
		req interface{},
		info *grpc.UnaryServerInfo,
		handler grpc.UnaryHandler,
	) (interface{}, error) {
		md, ok := metadata.FromIncomingContext(ctx)
		if !ok {
			return nil, status.Error(codes.Unauthenticated, "missing metadata")
		}

		tenantIDs := md.Get("x-tenant-id")
		if len(tenantIDs) == 0 || tenantIDs[0] == "" {
			return nil, status.Error(codes.Unauthenticated, "missing tenant ID")
		}

		tenantID := tenantIDs[0]
		if !allowedTenants[tenantID] {
			return nil, status.Error(codes.PermissionDenied, "unknown tenant")
		}

		ctx = context.WithValue(ctx, tenantKey{}, tenantID)
		return handler(ctx, req)
	}
}
```

### PostgreSQL RLS Policies

```sql
-- Enable RLS on tenant-scoped tables
ALTER TABLE orders ENABLE ROW LEVEL SECURITY;
ALTER TABLE orders FORCE ROW LEVEL SECURITY;

-- Policy: tenants can only see their own rows
CREATE POLICY tenant_isolation_policy ON orders
    USING (tenant_id = current_setting('app.current_tenant_id')::uuid);

-- Set tenant context at connection level (called from Django middleware)
-- SET LOCAL "app.current_tenant_id" = '<tenant-uuid>';

-- Verify isolation
DO $$
BEGIN
    PERFORM set_config('app.current_tenant_id', 'tenant-a-uuid', true);
    IF EXISTS (SELECT 1 FROM orders WHERE tenant_id != 'tenant-a-uuid'::uuid) THEN
        RAISE EXCEPTION 'RLS VIOLATION: cross-tenant data visible';
    END IF;
END $$;
```

### Cross-Tenant Isolation Test

```python
from django.test import TestCase, override_settings
from myapp.models import Tenant, Order
from myapp.middleware import _thread_local


class TenantIsolationTest(TestCase):
    def setUp(self):
        self.tenant_a = Tenant.objects.create(
            name="Acme Corp", subdomain="acme", schema_name="acme"
        )
        self.tenant_b = Tenant.objects.create(
            name="Globex Inc", subdomain="globex", schema_name="globex"
        )

    def test_tenant_a_cannot_see_tenant_b_data(self):
        _thread_local.tenant = self.tenant_b
        Order.objects.create(title="Secret Order", amount=999)

        _thread_local.tenant = self.tenant_a
        orders = Order.objects.all()
        self.assertEqual(orders.count(), 0)

    def test_query_without_tenant_raises(self):
        _thread_local.tenant = None
        with self.assertRaises(RuntimeError):
            list(Order.objects.all())

    def tearDown(self):
        _thread_local.tenant = None
```
