### Celery Configuration

```python
# celery_config.py
from kombu import Queue, Exchange

broker_url = "redis://redis:6379/0"
result_backend = "redis://redis:6379/1"

task_serializer = "json"
result_serializer = "json"
accept_content = ["json"]
timezone = "UTC"
enable_utc = True

# Reliability settings
task_acks_late = True
task_reject_on_worker_lost = True
worker_prefetch_multiplier = 1  # Fair dispatch, critical for long tasks
task_acks_on_failure_or_timeout = False

# Concurrency
worker_concurrency = 8
worker_max_tasks_per_child = 1000  # Prevent memory leaks

# Task routing
task_queues = (
    Queue("orders.high", Exchange("orders"), routing_key="orders.high"),
    Queue("orders.default", Exchange("orders"), routing_key="orders.default"),
    Queue("orders.dlq", Exchange("dlq"), routing_key="orders.dlq"),
    Queue("emails", Exchange("emails"), routing_key="emails"),
    Queue("analytics", Exchange("analytics"), routing_key="analytics"),
)

task_routes = {
    "tasks.process_order": {"queue": "orders.high"},
    "tasks.send_confirmation_email": {"queue": "emails"},
    "tasks.update_analytics": {"queue": "analytics"},
}

# Beat schedule for monitoring
beat_schedule = {
    "monitor-dlq-depth": {
        "task": "tasks.check_dlq_depth",
        "schedule": 60.0,
    },
}
```

### Idempotent Order Processing Task

```python
# tasks/order_processing.py
import hashlib
import logging
import random
import time
import uuid

from celery import shared_task
from django.db import IntegrityError

from myapp.models import Order, IdempotencyRecord

logger = logging.getLogger(__name__)


def _compute_idempotency_key(order_id, operation):
    return hashlib.sha256(f"{order_id}:{operation}".encode()).hexdigest()


@shared_task(
    bind=True,
    max_retries=5,
    acks_late=True,
    reject_on_worker_lost=True,
    autoretry_for=(ConnectionError, TimeoutError),
    retry_backoff=True,
    retry_backoff_max=300,
    retry_jitter=True,
)
def process_order(self, order_id, correlation_id=None):
    correlation_id = correlation_id or str(uuid.uuid4())
    log = logger.bind(
        order_id=order_id,
        correlation_id=correlation_id,
        task_id=self.request.id,
        attempt=self.request.retries + 1,
    ) if hasattr(logger, 'bind') else logger

    idem_key = _compute_idempotency_key(order_id, "process_order")

    try:
        IdempotencyRecord.objects.create(
            key=idem_key,
            task_id=self.request.id,
            status="processing",
        )
    except IntegrityError:
        existing = IdempotencyRecord.objects.get(key=idem_key)
        if existing.status == "completed":
            log.info("Skipping duplicate: already processed")
            return {"status": "duplicate", "order_id": order_id}
        log.info("Retrying previously failed attempt")

    try:
        order = Order.objects.select_for_update().get(id=order_id)

        if order.status not in ("pending", "retry"):
            log.info("Order not in processable state", status=order.status)
            return {"status": "skipped", "reason": f"order in {order.status} state"}

        _validate_inventory(order)
        _charge_payment(order)

        order.status = "confirmed"
        order.save()

        IdempotencyRecord.objects.filter(key=idem_key).update(status="completed")

        send_confirmation_email.delay(order_id, correlation_id=correlation_id)
        update_analytics.delay(order_id, event="order_confirmed", correlation_id=correlation_id)

        log.info("Order processed successfully")
        return {"status": "confirmed", "order_id": order_id}

    except Exception as exc:
        log.error("Order processing failed", error=str(exc))
        IdempotencyRecord.objects.filter(key=idem_key).update(status="failed")

        if self.request.retries >= self.max_retries:
            _send_to_dlq(order_id, exc, self.request.retries, correlation_id)
            log.critical("Max retries exhausted, sent to DLQ")
            return {"status": "dlq", "order_id": order_id}

        backoff = min(300, 2 * (2 ** self.request.retries))
        jitter = random.uniform(0, backoff)
        raise self.retry(exc=exc, countdown=jitter)


def _send_to_dlq(order_id, exception, attempt_count, correlation_id):
    from myapp.tasks import dlq_handler
    dlq_handler.apply_async(
        kwargs={
            "original_task": "process_order",
            "order_id": order_id,
            "error": str(exception),
            "attempt_count": attempt_count,
            "correlation_id": correlation_id,
        },
        queue="orders.dlq",
    )
```

### Idempotency Record Model

```python
from django.db import models


class IdempotencyRecord(models.Model):
    key = models.CharField(max_length=64, unique=True, db_index=True)
    task_id = models.CharField(max_length=255)
    status = models.CharField(
        max_length=20,
        choices=[
            ("processing", "Processing"),
            ("completed", "Completed"),
            ("failed", "Failed"),
        ],
    )
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        indexes = [
            models.Index(fields=["created_at"]),
        ]
```

### Go Kafka Consumer with Graceful Shutdown

```go
package consumer

import (
	"context"
	"encoding/json"
	"fmt"
	"log/slog"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

	"github.com/confluentinc/confluent-kafka-go/v2/kafka"
)

type MessageEnvelope struct {
	Version       int             `json:"version"`
	Type          string          `json:"type"`
	Timestamp     time.Time       `json:"timestamp"`
	CorrelationID string          `json:"correlation_id"`
	Payload       json.RawMessage `json:"payload"`
}

type Handler func(ctx context.Context, msg MessageEnvelope) error

type Consumer struct {
	consumer     *kafka.Consumer
	handlers     map[string]Handler
	idempotency  IdempotencyStore
	logger       *slog.Logger
	wg           sync.WaitGroup
	shutdownCh   chan struct{}
}

func NewConsumer(brokers, groupID string, topics []string) (*Consumer, error) {
	c, err := kafka.NewConsumer(&kafka.ConfigMap{
		"bootstrap.servers":        brokers,
		"group.id":                 groupID,
		"auto.offset.reset":        "earliest",
		"enable.auto.commit":       false,
		"max.poll.interval.ms":     300000,
		"session.timeout.ms":       30000,
		"heartbeat.interval.ms":    3000,
	})
	if err != nil {
		return nil, fmt.Errorf("creating consumer: %w", err)
	}

	if err := c.SubscribeTopics(topics, nil); err != nil {
		return nil, fmt.Errorf("subscribing to topics: %w", err)
	}

	return &Consumer{
		consumer:   c,
		handlers:   make(map[string]Handler),
		logger:     slog.Default(),
		shutdownCh: make(chan struct{}),
	}, nil
}

func (c *Consumer) RegisterHandler(eventType string, h Handler) {
	c.handlers[eventType] = h
}

func (c *Consumer) Run(ctx context.Context) error {
	sigCh := make(chan os.Signal, 1)
	signal.Notify(sigCh, syscall.SIGTERM, syscall.SIGINT)

	c.logger.Info("consumer started")

	for {
		select {
		case <-ctx.Done():
			return c.shutdown()
		case sig := <-sigCh:
			c.logger.Info("received signal, shutting down", "signal", sig)
			return c.shutdown()
		default:
			msg, err := c.consumer.ReadMessage(time.Second)
			if err != nil {
				if kafkaErr, ok := err.(kafka.Error); ok && kafkaErr.Code() == kafka.ErrTimedOut {
					continue
				}
				c.logger.Error("read error", "error", err)
				continue
			}
			c.processMessage(ctx, msg)
		}
	}
}

func (c *Consumer) processMessage(ctx context.Context, msg *kafka.Message) {
	var envelope MessageEnvelope
	if err := json.Unmarshal(msg.Value, &envelope); err != nil {
		c.logger.Error("failed to unmarshal message",
			"error", err,
			"topic", *msg.TopicPartition.Topic,
			"offset", msg.TopicPartition.Offset,
		)
		c.commitOffset(msg)
		return
	}

	log := c.logger.With(
		"type", envelope.Type,
		"correlation_id", envelope.CorrelationID,
		"topic", *msg.TopicPartition.Topic,
	)

	messageID := fmt.Sprintf("%s-%d-%d",
		*msg.TopicPartition.Topic,
		msg.TopicPartition.Partition,
		msg.TopicPartition.Offset,
	)
	if c.idempotency != nil && c.idempotency.Exists(ctx, messageID) {
		log.Info("skipping duplicate message")
		c.commitOffset(msg)
		return
	}

	handler, ok := c.handlers[envelope.Type]
	if !ok {
		log.Warn("no handler registered for event type, skipping")
		c.commitOffset(msg)
		return
	}

	if err := handler(ctx, envelope); err != nil {
		log.Error("handler failed", "error", err)
		// Don't commit — message will be redelivered on rebalance
		return
	}

	if c.idempotency != nil {
		c.idempotency.Mark(ctx, messageID, 24*time.Hour)
	}
	c.commitOffset(msg)
	log.Info("message processed successfully")
}

func (c *Consumer) commitOffset(msg *kafka.Message) {
	if _, err := c.consumer.CommitMessage(msg); err != nil {
		c.logger.Error("failed to commit offset", "error", err)
	}
}

func (c *Consumer) shutdown() error {
	c.logger.Info("initiating graceful shutdown")
	close(c.shutdownCh)
	c.wg.Wait()
	return c.consumer.Close()
}
```

### DLQ Monitoring Task

```python
@shared_task
def check_dlq_depth():
    from django_redis import get_redis_connection
    import json

    conn = get_redis_connection("default")
    dlq_length = conn.llen("orders.dlq")

    if dlq_length > 0:
        logger.critical(
            "DLQ contains unprocessed messages",
            dlq_name="orders.dlq",
            depth=dlq_length,
        )
        # Trigger PagerDuty or Slack alert
        send_alert(
            severity="critical",
            title=f"DLQ depth alert: {dlq_length} messages in orders.dlq",
            details={
                "queue": "orders.dlq",
                "depth": dlq_length,
                "action_required": "Investigate failed orders and reprocess or discard",
            },
        )
```

### Retry Strategy Visualization

```
Attempt 1: immediate
Attempt 2: random(0, min(300, 2 * 2^1)) = random(0, 4)    ≈ 0-4s
Attempt 3: random(0, min(300, 2 * 2^2)) = random(0, 8)    ≈ 0-8s
Attempt 4: random(0, min(300, 2 * 2^3)) = random(0, 16)   ≈ 0-16s
Attempt 5: random(0, min(300, 2 * 2^4)) = random(0, 32)   ≈ 0-32s
→ After 5 failures: move to DLQ, alert on-call
```
